# Docker Hub mirror prefix, including the final /. Leave empty or remove to use Docker Hub directly.
DOCKER_IMAGE_PREFIX=docker.1ms.run/
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn

# Python package sources (the CUDA wheels require their own matching index).
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PYTORCH_CU121_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cu121
PYTORCH_CU118_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cu118
MMCV_WHEEL_INDEX_URL=https://download.openmmlab.com/mmcv/dist/cu118/torch2.0.0/index.html

# Replace every token placeholder with a distinct random value before launch.
# For two hosts, use the same WORKER_TOKEN at both ends and matching tokens on each model link.
ADMIN_TOKEN=replace-with-random-admin-token
MEDIA_TOKEN=replace-with-random-media-token
WORKER_TOKEN=replace-with-random-worker-token
TTS_TOKEN=replace-with-random-tts-token
LIPSYNC_TOKEN=replace-with-random-lipsync-token
LLM_TOKEN=replace-with-llm-token-or-random-unused-value

# Replace PUBLIC_BASE_URL with an origin reachable from both Worker and browser.
PUBLIC_BASE_URL=http://localhost:8080
WORKER_URL=http://worker:8090
TTS_URL=http://tts:8091
LIPSYNC_URL=http://lipsync:8092

APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=8080
WORKER_BIND_ADDRESS=127.0.0.1
WORKER_HOST_PORT=8090
TTS_BIND_ADDRESS=127.0.0.1
TTS_HOST_PORT=8091
LIPSYNC_BIND_ADDRESS=127.0.0.1
LIPSYNC_HOST_PORT=8092

# Host NVIDIA GPU index or UUID. Each container sees only its selected GPU as cuda:0.
TTS_GPU_ID=0
LIPSYNC_GPU_ID=0

# OpenAI-compatible API base, for example an operator-provided HTTPS origin plus /v1.
# LLM published on this host: http://host.docker.internal:18003/v1
# Use the published host port; localhost would mean the app container.
LLM_URL=
LLM_MODEL=
TIMEZONE=Asia/Shanghai
WORKER_START_TIMEOUT=12m

COSYVOICE_WEIGHTS_DIR=./models/cosyvoice
MUSETALK_WEIGHTS_DIR=./models/musetalk
TTS_DATA_DIR=./data/tts
LIPSYNC_DATA_DIR=./data/lipsync
