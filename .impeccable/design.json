  "narrative": {
    "northStar": "钴蓝 · 轻盈编辑室",
    "overview": "以钴蓝 · 轻盈编辑室为视觉北极星：冷白底、清楚的编辑列和克制的操作强调，使普通运营者能够阅读素材、确认状态并完成直播操作。桌面是主要工作环境，手机延续同一控件语言。\n\n系统使用紧凑中文无衬线层级、细分隔线和真实上传素材。蓝色标记当前选择及主要操作；平面分组承担信息组织，图像与视频承担内容表现。",
    "keyCharacteristics": [
      "冷白底与钴蓝操作强调",
      "细分隔线与编辑列对齐",
      "真实素材、明确状态和可恢复错误",
      "桌面优先，窄屏连续堆叠"
    ],
    "rules": [
      {
        "name": "The Cobalt Selection Rule",
        "body": "钴蓝同时标记当前选择和主要行动，状态反馈使用各自语义色。",
        "section": "colors"
      },
      {
        "name": "The Flat Grouping Rule",
        "body": "静态编辑内容以分隔和间距组织，避免把每个区域变成同等强调的浮起卡片。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用钴蓝区分主要操作和当前选择，并保留辅助文字的安静层级。",
      "Do 延续统一描边 SVG 图标、可见键盘焦点和禁用状态。",
      "Do 用细分隔线和间距组织编辑内容，素材按真实比例容纳。",
      "Do 为长中文名称、地址和来源标识提供换行空间。"
    ],
    "donts": [
      "Don't 引入装饰性大标题、虚构运营指标或替代真实素材的插画。",
      "Don't 把所有内容都封装成同等强调的卡片。",
      "Don't 只暴露后端错误原文而缺少中文说明与恢复操作。"
    ]
  }
}
